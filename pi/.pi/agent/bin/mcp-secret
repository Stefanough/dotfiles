#!/usr/bin/env python3
"""Emit an MCP server env value from Claude Code's config so pi holds no second copy.

Usage: mcp-secret <server-name> <env-key>
       mcp-secret <server-name> --arg-after <flag>
"""
import json
import os
import sys

args = sys.argv[1:]
if len(args) == 2:
    server, mode, key = args[0], "env", args[1]
elif len(args) == 3 and args[1] == "--arg-after":
    server, mode, key = args[0], "arg", args[2]
else:
    sys.exit("usage: mcp-secret <server-name> <env-key|--arg-after <flag>>")

config = json.load(open(os.path.expanduser("~/.claude.json")))

scopes = [config.get("mcpServers") or {}]
scopes += [p.get("mcpServers") or {} for p in (config.get("projects") or {}).values()]

for scope in scopes:
    entry = scope.get(server)
    if not entry:
        continue
    if mode == "env" and key in (entry.get("env") or {}):
        sys.stdout.write(entry["env"][key])
        break
    argv = entry.get("args") or []
    if mode == "arg" and key in argv and argv.index(key) + 1 < len(argv):
        sys.stdout.write(argv[argv.index(key) + 1])
        break
else:
    sys.exit(f"no {key!r} for MCP server {server!r} in ~/.claude.json")
