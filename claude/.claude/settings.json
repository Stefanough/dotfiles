{
  "cleanupPeriodDays": 365,
  "permissions": {
    "allow": [
      "Read(*)",
      "Write",
      "Edit",
      "WebSearch",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Skill(keybindings-help)",
      "Bash(kubectl *)",
      "Bash(curl:*)",
      "Bash(psql:*)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(yarn *)",
      "Bash(node *)",
      "Bash(npx *)",
      "Bash(mkdir *)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:medium.com)",
      "WebFetch(domain:docs.sentry.io)",
      "WebFetch(domain:www.apollographql.com)",
      "WebFetch(domain:apisyouwonthate.com)",
      "WebFetch(domain:developers.redhat.com)",
      "WebFetch(domain:docs.commercetools.com)",
      "WebFetch(domain:python-statemachine.readthedocs.io)",
      "WebFetch(domain:statecharts.dev)",
      "WebFetch(domain:stately.ai)",
      "mcp__claude_ai_Linear__get_issue",
      "mcp__claude_ai_Linear__save_issue",
      "mcp__claude_ai_Linear__list_users",
      "mcp__claude_ai_Linear__list_teams",
      "mcp__claude_ai_Slack__slack_read_thread",
      "mcp__claude_ai_Sentry__get_issue_details",
      "mcp__plugin_posthog_posthog__exec",
      "Skill(update-config)",
      "Skill(pr-shepherd:pr-shepherd)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"'\"$CLAUDE_NOTIFICATION_MESSAGE\"'\" with title \"Claude Code\" sound name \"Glass\"'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/armitage/Source/claude-capture/hooks/on-capture.sh"
          },
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/tmux-pane-title.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/armitage/Source/claude-capture/hooks/on-capture.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/armitage/Source/claude-capture/hooks/on-session-start.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh",
    "refreshInterval": 2
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "bash ~/.claude/subagent-statusline.sh"
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "pr-shepherd@texture-tools": true,
    "discourse@ancient-agent": true,
    "focus@ancient-agent": true,
    "posthog@claude-plugins-official": true,
    "neon@claude-plugins-official": true,
    "datadog@datadog-claude-code-preview-ddviz": true,
    "lapdog@lapdog": true,
    "aws-core@claude-plugins-official": true,
    "refine@texture-tools": true,
    "distilling-runbooks@texture-tools": true
  },
  "extraKnownMarketplaces": {
    "ancient-agent": {
      "source": {
        "source": "git",
        "url": "git@github.com:Stefanough/ancient-agent-plugins.git"
      }
    },
    "datadog-claude-code-preview-ddviz": {
      "source": {
        "source": "github",
        "repo": "datadog-labs/claude-code-plugin",
        "ref": "preview-ddviz"
      }
    },
    "lapdog": {
      "source": {
        "source": "github",
        "repo": "DataDog/dd-apm-test-agent"
      }
    }
  },
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "autoCompactEnabled": false,
  "skipAutoPermissionPrompt": true,
  "enableAllProjectMcpServers": true
}
