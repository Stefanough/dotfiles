#  Do not track .DS_Store
*.DS_Store

# Do not track Vim plugins
vim/.vim/bundle/*
.netrwhist

# do not track binary for Vim spellcheck
*.spl

# do not track tmux plugins
tmux/.tmux/plugins/*

# do not track Claude local settings
claude/.claude/**/*.local.*

# do not track Claude cache
claude/.claude/cache/

# do not track Claude backups
claude/.claude/backups/

# Server-fetched state and CLI-managed directories. These are not symlinked into
# ~/.claude today, but a folded stow on a fresh machine would put them here.
claude/.claude/plugins/
claude/.claude/policy-limits.json
claude/.claude/mcp-needs-auth-cache.json
claude/.claude/history.jsonl
claude/.claude/projects/
claude/.claude/sessions/
claude/.claude/todos/
claude/.claude/shell-snapshots/
claude/.claude/statsig/
claude/.claude/telemetry/
claude/.claude/.credentials.json

# Campaign runbooks produced BY the distilling-runbooks skill stay on this
# machine. They encode internal service topology and are disposable
# per-campaign artifacts, not reusable technique. The meta-skill is published
# to the marketplace; its output never is. Add each new runbook here.
claude/.claude/skills/prisma7-upgrade/

# ~/.codex is a whole-directory symlink into this package, so Codex writes its
# entire runtime state (auth.json, sessions, sqlite, WAL) into the working tree.
# Allowlist, not denylist: anything Codex adds in a future release stays ignored
# until it is named here.
#
# rules/ and skills/ are deliberately absent: rules/default.rules is accumulated
# command-approval state (one-off /private/tmp paths, branch-specific pushes)
# and skills/.system/ is vendored by Codex on upgrade. Neither is authored.
codex/.codex/*
!codex/.codex/config.toml
!codex/.codex/AGENTS.md

# Not dotfiles.
projects/